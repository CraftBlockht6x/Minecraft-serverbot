# 全局配置(所有假人共用)
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxx
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
AI_TRIGGER=mention
AI_KEYWORDS=助手,AI,小黑
AI_GREETING=大家好,我是 XiaoHei,有事可以喊我!
AI_RATE_LIMIT_MS=5000
AI_LINE_DELAY_MS=500
AI_MAX_LINES=5

# CHAT_MODE: text / say / me
# text 直接发包(部分 1.26+ 原版服会断开); say/me 通过命令发送(需 OP)
CHAT_MODE=text

# 是否忽略来源为 [SERVER] 的消息(防止 /say /me 回显导致自循环)
IGNORE_SERVER_CHAT=true

# 是否打印原始数据包到日志(调试用,正常关闭)
RAW_PACKET_DEBUG=false
MAX_CONTEXT_LENGTH=20
AI_MAX_TOKENS=256
AI_TEMPERATURE=0.7
LOG_INTERVAL_MS=1000
ECHO_CHAT=false
