#!/usr/bin/env node
/**
 * mcbot - Minecraft Bedrock 假人管理 CLI
 */

const fs = require('fs');
const path = require('path');
const { spawn } = require('child_process');

const { DaemonClient } = require('../lib/IPC');
const Storage = require('../lib/Storage');
const Config = require('../lib/Config');
const Session = require('../lib/Session');

const BASE_DIR = path.resolve(__dirname, '..');
const storage = new Storage(BASE_DIR);

function usage() {
  console.log(`用法:
  mcbot <name>                  启动指定假人(后台守护)
  mcbot attach <name>           进入交互界面
  mcbot stop <name>             停止假人
  mcbot status [name]           查看状态
  mcbot list                    列出已配置假人
  mcbot say <name> <msg>        让假人发送聊天
  mcbot exec <name> <cmd>       让假人执行游戏命令
  mcbot logs <name> [--lines N] 查看日志
  mcbot history <name>          查看 AI 对话历史
  mcbot clear <name>            清空 AI 对话历史
  mcbot restart <name>          重启假人
  mcbot config [name]           查看配置`);
}

async function isRunning(botDir) {
  const client = new DaemonClient(botDir);
  const ok = await client.ping();
  client.close();
  return ok;
}

async function startBot(name) {
  const botDir = storage.botDir(name);
  if (!storage.exists(botDir)) {
    storage.ensureBotDir(name);
    console.log(`[${name}] 首次使用,已创建配置目录: ${botDir}`);
    console.log(`[${name}] 请编辑 ${path.join(botDir, '.env')} 后再次运行 mcbot ${name}`);
    return;
  }

  if (await isRunning(botDir)) {
    console.log(`[${name}] 已在运行中`);
    return;
  }

  const cfg = Config.loadBot(BASE_DIR, name);
  const daemonScript = path.join(BASE_DIR, 'lib', 'Daemon.js');
  const out = fs.openSync(path.join(botDir, 'daemon.log'), 'a');
  const err = fs.openSync(path.join(botDir, 'daemon.error.log'), 'a');

  const child = spawn(process.execPath, [
    `--max-old-space-size=${cfg.MEMORY_LIMIT_MB || 512}`,
    daemonScript,
    name,
  ], {
    detached: true,
    stdio: ['ignore', out, err],
  });

  child.unref();
  console.log(`[${name}] 守护进程已启动 (PID: ${child.pid}, 内存限制: ${cfg.MEMORY_LIMIT_MB || 512}MB)`);
}

async function attachBot(name) {
  const botDir = storage.botDir(name);
  if (!(await isRunning(botDir))) {
    console.log(`[${name}] 未运行,请先执行: mcbot ${name}`);
    return;
  }
  await Session.start(name, botDir, BASE_DIR);
}

async function sendCommand(name, type, content) {
  const botDir = storage.botDir(name);
  if (!(await isRunning(botDir))) {
    console.log(`[${name}] 未运行`);
    return;
  }
  const client = new DaemonClient(botDir);
  await client.connect();
  await client.send({ type, data: content });
  console.log(`[${name}] 已发送`);
  client.close();
}

async function stopBot(name) {
  const botDir = storage.botDir(name);
  if (!(await isRunning(botDir))) {
    console.log(`[${name}] 未运行`);
    return;
  }
  const client = new DaemonClient(botDir);
  await client.connect();
  await client.send({ type: 'stop' });
  console.log(`[${name}] 停止指令已发送`);
  client.close();
}

async function restartBot(name) {
  await stopBot(name);
  await new Promise((r) => setTimeout(r, 1500));
  await startBot(name);
}

async function statusBot(name) {
  const bots = name ? [name] : storage.listBots();
  for (const n of bots) {
    const botDir = storage.botDir(n);
    const running = await isRunning(botDir);
    const state = storage.readJson(path.join(botDir, 'state.json')) || {};
    if (running) {
      const uptime = state.startedAt ? formatDuration(Date.now() - state.startedAt) : '未知';
      const mem = state.memoryUsage ? `${Math.round(state.memoryUsage.rss / 1024 / 1024)}MB/${state.memoryLimit || '?'}MB` : '未知';
      console.log(`${n}: 在线 (运行 ${uptime}) | 内存: ${mem} | 重连: ${state.reconnectCount || 0}次`);
    } else {
      const reason = state.exitReason ? ` (${state.exitReason})` : '';
      console.log(`${n}: 离线${reason}`);
    }
  }
}

function listBots() {
  const bots = storage.listBots();
  if (bots.length === 0) {
    console.log('暂无已配置假人。执行 mcbot <name> 可自动创建。');
    return;
  }
  console.log('已配置假人:');
  bots.forEach((n) => console.log(`  - ${n}`));
}

function viewLogs(name, lines = 20) {
  const botDir = storage.botDir(name);
  const file = path.join(botDir, 'chat.log');
  if (!storage.exists(file)) {
    console.log(`[${name}] 暂无日志`);
    return;
  }
  const content = storage.readFile(file);
  const arr = content.split('\n').filter(Boolean);
  console.log(arr.slice(-lines).join('\n'));
}

function viewHistory(name) {
  const botDir = storage.botDir(name);
  const file = path.join(botDir, 'conversation.json');
  if (!storage.exists(file)) {
    console.log(`[${name}] 暂无对话历史`);
    return;
  }
  const conv = storage.readJson(file) || [];
  conv.forEach((m) => {
    if (m.role === 'user') console.log(`[用户] ${m.content}`);
    if (m.role === 'assistant') console.log(`[假人] ${m.content}`);
  });
}

async function clearHistory(name) {
  const botDir = storage.botDir(name);
  storage.writeJson(path.join(botDir, 'conversation.json'), []);
  if (await isRunning(botDir)) {
    const client = new DaemonClient(botDir);
    await client.connect();
    await client.send({ type: 'clearContext' });
    client.close();
  }
  console.log(`[${name}] 已清空对话历史`);
}

function viewConfig(name) {
  if (name) {
    const cfg = Config.loadBot(BASE_DIR, name);
    console.log(JSON.stringify(cfg, null, 2));
  } else {
    const cfg = Config.loadGlobal(BASE_DIR);
    console.log(JSON.stringify(cfg, null, 2));
  }
}

function formatDuration(ms) {
  const s = Math.floor(ms / 1000);
  const m = Math.floor(s / 60);
  const h = Math.floor(m / 60);
  if (h > 0) return `${h}小时${m % 60}分`;
  if (m > 0) return `${m}分${s % 60}秒`;
  return `${s}秒`;
}

async function main() {
  const args = process.argv.slice(2);
  if (args.length === 0) {
    usage();
    return;
  }

  const cmd = args[0];

  if (cmd === 'list') {
    listBots();
  } else if (cmd === 'status') {
    await statusBot(args[1]);
  } else if (cmd === 'config') {
    viewConfig(args[1]);
  } else if (cmd === 'attach' && args[1]) {
    await attachBot(args[1]);
  } else if (cmd === 'stop' && args[1]) {
    await stopBot(args[1]);
  } else if (cmd === 'restart' && args[1]) {
    await restartBot(args[1]);
  } else if (cmd === 'say' && args[1]) {
    await sendCommand(args[1], 'chat', args.slice(2).join(' '));
  } else if (cmd === 'exec' && args[1]) {
    await sendCommand(args[1], 'gameCommand', args.slice(2).join(' '));
  } else if (cmd === 'logs' && args[1]) {
    const linesIdx = args.indexOf('--lines');
    const lines = linesIdx >= 0 ? parseInt(args[linesIdx + 1], 10) || 20 : 20;
    viewLogs(args[1], lines);
  } else if (cmd === 'history' && args[1]) {
    viewHistory(args[1]);
  } else if (cmd === 'clear' && args[1]) {
    await clearHistory(args[1]);
  } else if (!cmd.startsWith('-') && args.length >= 1) {
    await startBot(cmd);
  } else {
    usage();
  }
}

main().catch((err) => {
  console.error('错误:', err.message);
  process.exit(1);
});
